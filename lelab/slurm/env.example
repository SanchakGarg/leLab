# LeLab training settings for this server, read by slurm/*.sbatch. Copy this file to .env and edit .env:
#   cp .env.example .env
# LeLab rewrites .env.example each time it sends the Slurm files, but never touches your .env.
# Folders may be absolute, start with ~/, or be relative to this project folder (__LELAB_PROJECT_DIR__).
# A variable on the sbatch command line wins over this file:  DATASET=other_dataset sbatch slurm/train_act.sbatch

# ======================================================================================================== folders ===
# Python environment with LeRobot: a venv or conda env folder (the one holding bin/python and bin/lerobot-train).
# Make one once, in an interactive job with internet (srun ... --pty bash), for example with uv:
#   uv venv --python 3.12 venv && uv pip install --python venv/bin/python "lerobot[smolvla,peft,training]==0.7.0"
LELAB_ENV_DIR=venv
# Datasets: the folder LeLab sends recorded datasets to ("Folder on the server" in Send to server).
DATASET_DIR=__LELAB_DATASET_DIR__
# The dataset to train on: a folder name inside DATASET_DIR, or an absolute path to a dataset.
DATASET=
# Training runs (checkpoints and logs), one folder per run.
OUTPUT_DIR=outputs
# Finished policies: each run's last checkpoint is copied to POLICY_DIR/<run> when training ends.
POLICY_DIR=policies
# Hugging Face cache (smolvla_base and the other starting weights).
HF_HOME=hf_cache
# 1 when the GPU nodes have no internet: download the weights once in an interactive job first, e.g.
#   HF_HOME=hf_cache venv/bin/python -c "from huggingface_hub import snapshot_download as d; d('lerobot/smolvla_base'); d('HuggingFaceTB/SmolVLM2-500M-Video-Instruct')"
HF_HUB_OFFLINE=0
# Optional: modules to load before training (e.g. "cuda/12.4"), and a command to run first (e.g. activating conda:
# "source ~/miniconda3/etc/profile.d/conda.sh && conda activate lelab"; then point LELAB_ENV_DIR at that env).
LELAB_MODULES=
LELAB_SETUP=

# ================================================================================================ every training ===
DEVICE=cuda
SAVE_FREQ=10000          # checkpoint every this many steps; resubmitting resumes from the last one
LOG_FREQ=200
NUM_WORKERS=4            # data-loading processes; keep it below the job's CPUs
AUGMENT=0                # 1 = random brightness/contrast/saturation/hue/sharpness on the camera images
SEED=
RUN_TAG=                 # added to the run name, to start a second run with the same settings
EXTRA_TRAIN_ARGS=        # more lerobot-train options, e.g. "--policy.use_amp=true"

# Trackio (Hugging Face's experiment tracker, part of lerobot[training]): loss, learning rate and speed of every run.
TRACKIO=1                # 0 = off
TRACKIO_PROJECT=lelab    # runs are grouped by project
TRACKIO_DIR=trackio      # where runs are stored on this server; view them in an interactive job with
                         #   TRACKIO_DIR=trackio venv/bin/trackio show --project lelab
                         # and an SSH tunnel to the port it prints (ssh -N -L 7860:<node>:7860 <you>@<login>)
# Or sync each run live to a private Hugging Face Space (user/space; created if missing). Needs internet on the
# GPU node and a write token: put HF_TOKEN=hf_... here (LeLab creates .env readable only by you).
TRACKIO_SPACE_ID=

# ======================================================================== ACT (train_act / train_act_lora) ===
ACT_STEPS=100000
ACT_BATCH=32             # lower it on "CUDA out of memory"
ACT_CHUNK=100            # actions predicted per inference (30 fps: 100 = 3.3 s); new runs only
ACT_N_ACTION_STEPS=      # actions played before predicting again; empty = the whole chunk
ACT_LR=1e-5              # train_act: transformer and ResNet alike
# A trained ACT to start from (a pretrained_model folder, e.g. policies/act_full_<dataset>, or a Hub repo id).
# train_act: empty = from scratch. train_act_lora: required.
ACT_INIT=
ACT_LORA_R=16
ACT_LORA_ALPHA=32
ACT_LORA_LR=1e-4

# ======================================================= SmolVLA (train_smolvla_full / train_smolvla_lora) ===
SMOLVLA_BASE=lerobot/smolvla_base
SMOLVLA_STEPS=30000      # the cosine LR schedule is stretched to this many steps
SMOLVLA_BATCH=32         # full fine-tune uses much more memory: try 8-16 on a 23 GB GPU slice
# Cameras in the order smolvla_base knows them (camera1, camera2, camera3), e.g. "front,wrist".
# Empty = the dataset's own order. SMOLVLA_RENAME_MAP (JSON, or "none") replaces the mapping entirely.
SMOLVLA_CAMERAS=
SMOLVLA_RENAME_MAP=
# train_smolvla_full
SMOLVLA_LR=1e-4
SMOLVLA_DECAY_LR=2.5e-6
SMOLVLA_FREEZE_VISION=false   # true = keep the vision encoder frozen
SMOLVLA_EXPERT_ONLY=false     # true = train only the action expert (LeRobot's usual, lighter fine-tune)
# train_smolvla_lora
SMOLVLA_LORA_TARGET=expert    # expert = LeRobot's default (action expert q/v + projections); vlm = also the VLM and
                              # vision encoder, so the image features adapt to your cameras (more memory)
SMOLVLA_LORA_R=64
SMOLVLA_LORA_ALPHA=64
SMOLVLA_LORA_LR=1e-3
SMOLVLA_LORA_DECAY_LR=1e-4

# ============================================================================================ serve_policy ===
# The policy to serve: a pretrained_model folder (e.g. policies/smolvla_lora_<dataset>) or a Hub repo id.
# Empty = the newest run in POLICY_DIR.
POLICY=
SERVE_PORT=5555
SERVE_DEVICE=cuda
SERVE_N_ACTION_STEPS=
